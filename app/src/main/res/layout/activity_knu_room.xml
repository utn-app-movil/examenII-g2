<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="top|center_horizontal">

        <TextView
            android:id="@+id/knu_txtDetailRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/knu_room_detail_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/knu_txtDetailRoomCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capacity:"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/knu_txtDetailRoomStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/knu_txtDetailRoomUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User:"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/knu_txtDetailRoomDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date:"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/knu_btnBookRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/knu_book_room"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/knu_btnUnbookRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/knu_unbook_room"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
