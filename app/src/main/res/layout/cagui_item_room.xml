<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cagui_cardRoom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cagui_tvRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Room Name"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/cagui_tvRoomStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cagui_room_available"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_green_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@android:color/darker_gray"/>
        </LinearLayout>

        <TextView
            android:id="@+id/cagui_tvRoomDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/cagui_tvRoomCapacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Capacity: 0"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/cagui_tvRoomFloor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Floor: 0"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/cagui_tvRoomBuilding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Building: "
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
