<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/esteb_bg_gradient"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".esteb_LoginActivity">

    <LinearLayout
        android:layout_width="378dp"
        android:layout_height="534dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/esteb_card_background">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/esteb_circle_account" />

        <EditText
            android:id="@+id/edtUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/esteb_nameUser_viw"
            android:inputType="textPersonName"
            android:padding="18dp"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edtContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:hint="@string/esteb_password_viw"
            android:inputType="textPassword"
            android:padding="18dp"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="#4180ab"
            android:padding="14dp"
            android:text="@string/esteb_loggin"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

</RelativeLayout>