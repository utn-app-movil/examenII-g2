<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/alex_btn_back_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alex_btn_back"
            android:backgroundTint="#888888"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alex_create_title"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <EditText
        android:id="@+id/alex_et_create_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/alex_hint_room_name"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/alex_et_create_capacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/alex_hint_capacity"
        android:inputType="number"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/alex_btn_create_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/alex_btn_save"/>

</LinearLayout>