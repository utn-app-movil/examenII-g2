<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/fer_tv_create_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fer_create_room_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fer_til_room_name"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/fer_til_room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/fer_tv_create_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fer_til_capacity">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/fer_et_room_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fer_room_name"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/fer_til_capacity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/fer_til_room_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fer_btn_create_room">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/fer_et_capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fer_capacity"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/fer_btn_create_room"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fer_create_room"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/fer_til_capacity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fer_btn_back" />

    <Button
        android:id="@+id/fer_btn_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fer_back"
        android:textSize="16sp"
        style="?attr/materialButtonOutlinedStyle"
        app:layout_constraintTop_toBottomOf="@id/fer_btn_create_room"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
