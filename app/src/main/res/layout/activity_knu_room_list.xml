<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Encabezado con usuario y botón de refrescar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/knu_txtUserHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="User:"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/knu_btnRefreshRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/knu_refresh_rooms" />
    </LinearLayout>

    <!-- Sección para crear sala -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/knu_create_room"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/knu_txtNewRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/knu_room_name" />

        <EditText
            android:id="@+id/knu_txtNewRoomCapacity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/knu_capacity"
            android:inputType="number"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/knu_btnCreateRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/knu_create_room"
        android:layout_marginTop="8dp" />

    <!-- Lista de salas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/knu_recyclerRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>
