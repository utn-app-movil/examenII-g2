<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/cagui_tvTitleRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cagui_room_creation_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cagui_etRoomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cagui_room_name_hint"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cagui_etRoomDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cagui_room_description_hint"
                android:inputType="textMultiLine"
                android:lines="3"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cagui_etRoomCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cagui_room_capacity_hint"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cagui_etRoomFloor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cagui_room_floor_hint"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cagui_etRoomBuilding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cagui_room_building_hint"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/cagui_btnCreateRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cagui_create_room_button"
            android:textSize="16sp"/>

        <ProgressBar
            android:id="@+id/cagui_progressBarRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
