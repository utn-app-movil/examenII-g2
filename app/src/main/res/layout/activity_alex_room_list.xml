<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/alex_btn_back_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alex_btn_back"
            android:backgroundTint="#888888"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/alex_btn_refresh"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/alex_btn_refresh"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/alex_btn_go_create"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/alex_btn_new_room"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/alex_rv_rooms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>